#
# Refuse a commit that would leave the generated page out of step with the
# Markdown it is built from. The PDF editions are only mentioned, never
# refused: they are published by hand.
#
# Enabled by `make hooks`, which points core.hooksPath at .githooks/ so the
# hook is versioned with the repo instead of living only in one clone.
# Bypass a single commit with `git commit --no-verify`.

set -u

cd "$(git rev-parse --show-toplevel)" || exit 1

PAGES="docs/index.html"
PDFS="docs/working-with-ai-agents.pdf
docs/prace-s-ai-agenty.pdf"
SOURCES="HANDBOOK.md
HANDBOOK.cs.md
WALKTHROUGHS.md
WALKTHROUGHS.cs.md
PROMPTS.md
PROMPTS.cs.md
web/template.html
web/build.py
web/print.css
web/pdf.py"

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# Only look when this commit touches something one of the builds reads.
touched=0
for f in $SOURCES; do
    if printf '%s\n' "$staged" | grep -qxF "$f"; then
        touched=1
        break
    fi
done
[ "$touched" -eq 0 ] && exit 0

if [ ! -x .venv/bin/python ]; then
    echo "pre-commit: .venv is missing, so the page cannot be checked." >&2
    echo "            Run 'make setup', or commit with --no-verify." >&2
    exit 1
fi

# 1. Is the generated page current with respect to the sources on disk?
if ! .venv/bin/python web/build.py --check >/dev/null 2>&1; then
    echo "pre-commit: $PAGES is out of date." >&2
    echo "            You changed a source document without rebuilding." >&2
    echo >&2
    echo "            make build && git add $PAGES" >&2
    exit 1
fi

# 2. It is current, but was the rebuild actually included in this commit?
for page in $PAGES; do
    if ! git diff --quiet -- "$page"; then
        echo "pre-commit: $page was rebuilt but is not staged." >&2
        echo "            Committing the sources without it leaves the two out of step." >&2
        echo >&2
        echo "            git add $page" >&2
        exit 1
    fi
done

# 3. The PDFs are published by hand, so this only says they have fallen behind.
#    The comparison is by modification time rather than by rebuilding them:
#    it costs nothing, and the commit goes through either way. `make check`
#    is the one that compares the bytes.
for pdf in $PDFS; do
    [ -f "$pdf" ] || continue
    for src in $SOURCES; do
        if [ "$src" -nt "$pdf" ]; then
            echo "pre-commit: the PDF editions are older than the sources." >&2
            echo "            Run 'make pdf' when you next want to publish them." >&2
            exit 0
        fi
    done
done

exit 0
